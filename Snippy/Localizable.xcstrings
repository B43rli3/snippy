      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Snippy braucht die Bildschirmaufnahme, um den Bildschirm einzufrieren und zu speichern." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Snippy needs Screen Recording permission to freeze and save your screen." } }
      }
